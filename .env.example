# ── Backend (server/) — set these on the VPS ────────────────────────────────

# Required in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# The port the Express API listens on (your reverse proxy forwards to this).
PORT=4310

NODE_ENV=production

# Comma-separated list of frontend origins allowed to send credentialed
# requests — e.g. your Vercel production domain and any custom domain.
# No trailing slashes, no paths.
CLIENT_ORIGINS=https://your-app.vercel.app,https://portal.yourdomain.org

# No domain for the backend yet? See README.md's "No domain name yet?"
# section — a free hostname like 203-0-113-10.sslip.io (for VPS IP
# 203.0.113.10) works fine here and gets you a real HTTPS certificate.

# "none" (default in production) is required if the frontend and backend are
# on different registrable domains. If you instead deploy them as subdomains
# of the SAME domain (recommended — e.g. app.yourdomain.org + api.yourdomain.org),
# set this to "lax" for a more restrictive, conventional cookie.
COOKIE_SAMESITE=none

# ── Frontend (Vite) — set this in Vercel's Project Settings → Environment Variables ──

# Full origin + /api of your VPS backend (e.g. https://203-0-113-10.sslip.io/api
# if you don't have a domain yet). Leave unset for local dev (Vite proxies
# /api to localhost:4310 automatically).
VITE_API_URL=https://api.yourdomain.org/api
